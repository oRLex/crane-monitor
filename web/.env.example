# HMAC secret for the signed session cookie (min 32 chars in production).
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Real-time transport for the dashboard: "sse" (built-in mock hub) or "signalr".
NEXT_PUBLIC_REALTIME=sse
# Azure SignalR / ASP.NET Core hub URL, used when NEXT_PUBLIC_REALTIME=signalr.
NEXT_PUBLIC_SIGNALR_HUB_URL=https://your-api.azurewebsites.net/hubs/telemetry

# Data source: leave empty for the in-memory repository, set to use Prisma + PostgreSQL.
# Prisma Postgres on Vercel uses prisma+postgres://accelerate.prisma-data.net/?api_key=...
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cranes"
