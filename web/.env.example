# Laravel API base URL, used server-side only (the browser never talks to the API directly;
# it goes through /api/backend/*, which adds the user's token from an httpOnly cookie).
API_URL=http://localhost:8000/api

# WebSockets: Laravel Reverb locally, Pusher Channels in production (same protocol).
# Pusher: KEY=<app key>, HOST=ws-<cluster>.pusher.com (e.g. ws-eu.pusher.com), PORT=443, SCHEME=https.
NEXT_PUBLIC_REVERB_KEY=cranewatch-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
