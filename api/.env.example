APP_NAME=CraneWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Next.js origin(s) allowed by CORS (comma-separated).
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL with the pgvector extension (docker compose: pgvector/pgvector:pg17 on 5433).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=cranewatch
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis: cache, Horizon queues, rate limits, AI token budgets, live telemetry state.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6390
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Telemetry bus: "rabbitmq" (simulate -> broker -> consume) or "sync" (single process, no broker).
TELEMETRY_BUS=rabbitmq
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2f
TELEMETRY_TICK_MS=1000

# Real-time: Laravel Reverb (managed WebSockets on Laravel Cloud).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cranewatch
REVERB_APP_KEY=cranewatch-key
REVERB_APP_SECRET=cranewatch-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Production on Wasmer Edge uses Pusher Channels (same protocol): BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=eu

# AI. Without ANTHROPIC_API_KEY the app runs a deterministic mock LLM, so every AI
# feature works offline (and in tests). Without VOYAGE_API_KEY embeddings are mocked.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Daily token budget per tenant (input + output); platform roles share the "platform" bucket.
AI_DAILY_TOKEN_BUDGET=400000
