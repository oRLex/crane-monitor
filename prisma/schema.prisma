// Prisma schema targeting PostgreSQL (Prisma Postgres on Vercel in production).
// The app runs without a database by default (in-memory repository);
// set DATABASE_URL and run `npm run db:push && npm run db:seed` to switch to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id     String  @id
  name   String
  sites  Site[]
  cranes Crane[]
  users  User[]
}

model Site {
  id       String  @id
  name     String
  city     String
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  cranes   Crane[]

  @@index([tenantId])
}

model Crane {
  id            String   @id
  name          String
  model         String
  serialNumber  String   @unique
  maxLoadT      Float
  jibLengthM    Float
  ratedMomentTm Float
  streamUrl     String?
  siteId        String
  tenantId      String
  site          Site     @relation(fields: [siteId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alarms        Alarm[]
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([siteId])
}

model User {
  id       String  @id
  email    String  @unique
  name     String
  // admin | operator | customer_manager | customer_viewer
  role     String
  // null for platform-wide roles (admin, operator)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
}

model Alarm {
  id             String    @id
  craneId        String
  // wind | overload | offline
  kind           String
  // warning | critical
  severity       String
  message        String
  raisedAt       DateTime
  acknowledgedAt DateTime?
  acknowledgedBy String?
  crane          Crane     @relation(fields: [craneId], references: [id])

  @@index([craneId, raisedAt])
}

// Raw telemetry is expected to live in a time-series store (Azure Data Explorer /
// TimescaleDB). PostgreSQL keeps only aggregated history for reports.
model TelemetryHourly {
  craneId      String
  hour         DateTime
  maxLoadT     Float
  maxMomentPct Float
  maxWindMs    Float
  operatingMin Int

  @@id([craneId, hour])
}
